{
  "host": "0.0.0.0",
  "port": 8787,
  "providers": [
    {
      "name": "groq",
      "priority": 1,
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "max_tokens_cap": 32768,
      "default_model": "openai/gpt-oss-120b",
      "models": {
        "claude-3-5-sonnet*": "openai/gpt-oss-120b",
        "claude-3-7-sonnet*": "openai/gpt-oss-120b",
        "claude-3-opus*": "openai/gpt-oss-120b",
        "claude-3-5-haiku*": "openai/gpt-oss-20b",
        "claude-3-haiku*": "openai/gpt-oss-20b"
      }
    },
    {
      "name": "gemini",
      "priority": 2,
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_env": "GEMINI_API_KEY",
      "default_model": "gemini-3.8-flash",
      "max_tokens_cap": 65536,
      "models": {
        "claude-opus*": "gemini-3.8-flash",
        "claude-sonnet*": "gemini-3.8-flash",
        "claude-haiku*": "gemini-3.8-flash",
        "*": "gemini-3.8-flash"
      }
    },
    {
      "name": "cerebras",
      "priority": 3,
      "base_url": "https://api.cerebras.ai/v1",
      "api_key_env": "CEREBRAS_API_KEY",
      "default_model": "llama3.3-70b",
      "models": {
        "claude-3-5-sonnet*": "llama3.3-70b",
        "claude-3-5-haiku*": "llama3.1-8b",
        "*": "llama3.3-70b"
      }
    },
    {
      "name": "openrouter",
      "priority": 4,
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "max_tokens_cap": 32768,
      "default_model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "models": {
        "claude-opus*": "nvidia/nemotron-3-ultra-550b-a55b:free",
        "claude-sonnet*": "nvidia/nemotron-3-ultra-550b-a55b:free",
        "claude-haiku*": "nvidia/nemotron-3.5-lightning:free",
        "*": "nvidia/nemotron-3-ultra-550b-a55b:free"
      },
      "extra_headers": {
        "HTTP-Referer": "https://github.com/",
        "X-Title": "claude-free-router"
      }
    },
    {
      "name": "mistral",
      "priority": 5,
      "base_url": "https://api.mistral.ai/v1",
      "api_key_env": "MISTRAL_API_KEY",
      "default_model": "mistral-small-latest",
      "models": {
        "*": "mistral-small-latest"
      }
    },
    {
      "name": "github-models",
      "priority": 6,
      "base_url": "https://models.inference.ai.azure.com",
      "api_key_env": "GITHUB_TOKEN",
      "default_model": "gpt-4o-mini",
      "models": {
        "claude-3-5-sonnet*": "gpt-4o",
        "claude-3-5-haiku*": "gpt-4o-mini",
        "*": "gpt-4o-mini"
      }
    },
    {
      "name": "together",
      "priority": 7,
      "base_url": "https://api.together.xyz/v1",
      "api_key_env": "TOGETHER_API_KEY",
      "default_model": "meta-llama/Llama-3.3-70B-Instruct-Turbo",
      "models": {
        "*": "meta-llama/Llama-3.3-70B-Instruct-Turbo"
      }
    }
  ]
}
