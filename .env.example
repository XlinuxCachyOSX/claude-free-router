# Provider gratuiti - inserisci le tue API key (una o più)
# Il router usa solo i provider per cui esiste una chiave, in ordine di priorità.

# 1) Groq - https://console.groq.com/keys  (velocissimo, tier gratuito generoso)
export GROQ_API_KEY=""

# 2) Google Gemini - https://aistudio.google.com/app/apikey  (tier gratuito)
export GEMINI_API_KEY=""

# 3) Cerebras - https://cloud.cerebras.ai/  (tier gratuito)
export CEREBRAS_API_KEY=""

# 4) OpenRouter - https://openrouter.ai/keys  (modelli ":free")
export OPENROUTER_API_KEY=""

# 5) Mistral - https://console.mistral.ai/api-keys/  (tier gratuito)
export MISTRAL_API_KEY=""

# 6) GitHub Models - usa un Personal Access Token con scope "models"
#    https://github.com/settings/tokens
export GITHUB_TOKEN=""

# 7) Together AI - https://api.together.xyz/settings/api-keys
export TOGETHER_API_KEY=""

# Configurazione server (opzionale)
export CFR_HOST="0.0.0.0"
export CFR_PORT="8787"
