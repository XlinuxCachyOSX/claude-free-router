# Provider gratuiti - inserisci le tue API key (una o più)
# Il router usa solo i provider per cui esiste una chiave, in ordine di priorità.
# Combinazione consigliata: Groq + Gemini + OpenRouter (vedi README).

# 1) Groq - https://console.groq.com/keys  (velocissimo, tier gratuito)
#    ⚠️ quota TPM bassa (~8000): su prompt grandi (Claude Code) può rispondere 413
export GROQ_API_KEY=""

# 2) Google Gemini - https://aistudio.google.com/app/apikey  (tier gratuito)
#    Consigliato: gestisce bene il tool calling (thought_signature)
export GEMINI_API_KEY=""

# 3) Cerebras - https://cloud.cerebras.ai/  (tier gratuito, molto veloce)
export CEREBRAS_API_KEY=""

# 4) OpenRouter - https://openrouter.ai/keys  (modelli ":free")  <-- CONSIGLIATO come fallback
#    es. nvidia/nemotron-3-ultra-550b-a55b:free (contesto 1M, supporta i tool)
export OPENROUTER_API_KEY=""

# 5) Mistral - https://console.mistral.ai/api-keys/  (⚠️ ora richiede un piano a pagamento)
export MISTRAL_API_KEY=""

# 6) GitHub Models - Personal Access Token con scope "models"
#    https://github.com/settings/tokens  (⚠️ spesso non raggiungibile/inaffidabile)
export GITHUB_TOKEN=""

# 7) Together AI - https://api.together.xyz/settings/api-keys
export TOGETHER_API_KEY=""

# Configurazione server (opzionale)
export CFR_HOST="0.0.0.0"
export CFR_PORT="8787"
